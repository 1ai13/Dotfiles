// -*- mode: jsonc -*
[
{
    "include": "shared-config.jsonc",
    "layer": "top",
    "output": "DP-3",
    "modules-center": ["hyprland/workspaces"],
    "modules-left": ["custom/nvidia","disk","memory","cpu"],
    "modules-right": ["custom/pacman","wireplumber","wireplumber#source","network","clock","custom/power"],
    "hyprland/window": {
        "max-length": 30
    },

        "clock": {
        "format": "{:%H:%M} ",
        "format-alt": "{:%a, %d. %b  %H:%M} ",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
                    "mode"          : "month",
                    "mode-mon-col"  : 3,
                    "weeks-pos"     : "right",
                    "on-scroll"     : 1,
                    "format": {
                              "months":     "<span color='#ffead3'><b>{}</b></span>",
                              "days":       "<span color='#ecc6d9'><b>{}</b></span>",
                              "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
                              "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
                              "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
                              }
                    },
        "actions":  {
                    "on-click-right": "mode",
                    "on-scroll-up": "tz_up",
                    "on-scroll-down": "tz_down",
                    "on-scroll-up": "shift_up",
                    "on-scroll-down": "shift_down"
                    }
    },
    "cpu": {
      "interval": 15,
      "format": "  {usage}%",
      "max-length": 10,
      "states": {
        "warn": 60,
        "crit": 80
      }
    },
    "disk": {
      "interval": 240,
      "format": "  {percentage_used}%",
      "tooltip-format": "{used} out of {total}",
      "path": "/",
      "states": {
        "warn": 75,
        "crit": 85
      }
    },
    "memory": {
    "interval": 15,
    "format": "  {}%",
    "max-length": 10,
    "states":{
      "warn": 70,
      "crit": 85
    }
    },
    "network": {
    "format-ethernet": "󰖩",
    "format-disconnected": "󰖪", //An empty format will hide the module.
    "format-alt": "{ipaddr} 󰖩",
    "tooltip": false,
    "max-length": 50
    },
   "wireplumber": {
    "format": "{volume}% {icon}",
    "format-muted": "",
    "on-click": "pavucontrol",
    "format-icons": ["", "", ""],
    "scroll-step": 2
    },
    "wireplumber#source": {
    "node-type": "Audio/Source",
    "format": "󰍬",
    "format-muted": "󰍭",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "scroll-step": 0,
    "tooltip": false
    },
    "custom/nvidia": {
    "exec": "nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,nounits,noheader | sed 's/\\([0-9]\\+\\), \\([0-9]\\+\\)/\\1%  \\2°C/g'",
    "format": "󰢹  {}",
    "tooltip": false,
    "interval": 20
    },
    //alternate
"custom/pacman": {
    "format": "{}  ",
    "interval": 3600, // every hour
    "return-type": "json",
    "exec": "~/.config/scripts/update-checker.sh",       // # of updates
    "exec-if": "exit 0",                  // always run; consider advanced run conditions
    "on-click": "kitty --single-instance -e bash -c 'sudo pacman -Syu && pkill -SIGRTMIN+8 waybar'", // update system
    "signal": 8
    },
    "custom/power": {
    "format" : "󰐥",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "~/.config/waybar/power_menu.xml",
        "menu-actions": {
            "shutdown": "poweroff",
            "reboot": "reboot",
            "suspend": "systemctl suspend"
        }
    }
},
{
  "include": "shared-config.jsonc",
  "layer": "top",
  "output": "DP-2",
  "modules-center": ["hyprland/workspaces"]
}
]
